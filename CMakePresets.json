{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "description": "The everyday build: -std=c++17 -Wall -g -pthread, no optimisation."
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "Optimised (-O3 -DNDEBUG), still with -g.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "AddressSanitizer + UBSan",
      "description": "ASan and UBSan in one pass; -fno-sanitize-recover=all makes any UB report fatal.",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-O1 -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer",
      "description": "TSan cannot be combined with ASan. `make tsan` adds the setarch -R ASLR probe on top of this.",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-O1 -fno-omit-frame-pointer -fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Source-based coverage (clang)",
      "description": "clang's -fprofile-instr-generate -fcoverage-mapping; `make coverage` runs the suite and reports.",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate"
      }
    },
    {
      "name": "strict",
      "inherits": "base",
      "displayName": "Warnings as errors",
      "description": "-Wall -Wextra -Werror over everything this project owns; system headers are exempt.",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wextra -Werror -Wno-missing-field-initializers -Wno-unused-parameter"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "libFuzzer + ASan + UBSan (clang)",
      "description": "Stack instrumented with fuzzer-no-link; harnesses in fuzz/ link the fuzzer runtime. Only the stack and the harnesses are built. `make fuzz` runs them.",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-O1 -fno-omit-frame-pointer -fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "TCPIP_BUILD_TESTS": "OFF",
        "TCPIP_BUILD_APPS": "OFF",
        "TCPIP_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "mutation",
      "inherits": "base",
      "displayName": "Mutation testing (clang + Mull)",
      "description": "Debug build with clang, unoptimised so mutants are not folded away; Mull's plugin is added to the files under test when TCPIP_MULL_PLUGIN is set (`make mutation` does). No compiler launcher: a compiler cache and a pass plugin do not mix.",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_COMPILER_LAUNCHER": "",
        "TCPIP_BUILD_APPS": "OFF"
      }
    },
    {
      "name": "bench",
      "inherits": "base",
      "displayName": "Benchmarks (Release, -O2 -g)",
      "description": "Optimised build of the stack plus the Google Benchmark binaries in bench/. -O2 -DNDEBUG rather than release's -O3 so the numbers track what a normal optimised build does.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -g -DNDEBUG",
        "TCPIP_BUILD_TESTS": "OFF",
        "TCPIP_BUILD_APPS": "OFF",
        "TCPIP_BUILD_BENCH": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "strict",
      "configurePreset": "strict"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "bench",
      "configurePreset": "bench"
    },
    {
      "name": "mutation",
      "configurePreset": "mutation"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "configurePreset": "coverage",
      "environment": {
        "LLVM_PROFILE_FILE": "${sourceDir}/build/coverage/profraw/%p.profraw"
      }
    },
    {
      "name": "strict",
      "inherits": "base",
      "configurePreset": "strict"
    }
  ]
}
